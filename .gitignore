# Ignore files generated by Keil and other tools
/Programs/*/DebugConfig/
/Programs/*/ITSboard/
/Programs/*/RTE/
/Programs/*/out/
/Programs/*/tmp/
/Programs/*/*.cbuild-idx.yml
/Programs/*/*.cbuild-pack.yml
/Programs/**/.clangd
/Programs/*/.clangd
/Programs/**/.cmsis/tools-environment.yml
/Programs/*/clang_tidy_result.txt
__pycache__/
.vscode.d/
/.vscode/cmsis.json
/.vscode/launch.json

# Ignore User specific setting
/Programs/*/*.uvguix.*

# Ignore office lock files, which can include user-specific home-directory paths
**/.~lock.*#

### macOS ###
# General
.DS_Store
.AppleDouble
.LSOverride

